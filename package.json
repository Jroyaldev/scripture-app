{
  "name": "scripture-app",
  "version": "0.1.0",
  "productName": "Pericope",
  "description": "Pericope — a local-first, open-source knowledge tool where canonical Scripture is the structured organizing spine. A Shepherdly product (marktheword.com).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build-electron.mjs",
    "build:renderer": "node scripts/build-renderer.mjs",
    "dev:renderer": "vite --config vite.config.ts",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.embedding-host.json",
    "typecheck": "tsc --noEmit",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:connections:native": "env ELECTRON_RUN_AS_NODE=1 electron --import tsx --test tests/authored-connection-broker.test.ts tests/connection-mutation-reconciliation.test.ts tests/connection-persistence.test.ts tests/revision-append-recovery.test.ts tests/git-revision-store-lazy.test.ts tests/snapshot-revision-store.test.ts tests/electron-lifecycle-contract.test.ts tests/marking-surfaces-contract.test.ts",
    "library": "node --import tsx src/cli/index.ts",
    "electron": "env -u ELECTRON_RUN_AS_NODE electron dist/electron/main.cjs",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "node scripts/rebuild-electron-native.cjs",
    "preflight:electron": "env -u ELECTRON_RUN_AS_NODE electron scripts/preflight-native.cjs",
    "start": "npm run build && npm run build:renderer && npm run preflight:electron && npm run electron",
    "verify:m2": "node --import tsx scripts/verify-m2.ts",
    "verify:m3": "node --import tsx scripts/verify-m3.ts",
    "verify:m4": "node --import tsx scripts/verify-m4.ts",
    "verify:m5": "node --import tsx scripts/verify-m5.ts",
    "verify:m6": "node --import tsx scripts/verify-m6.ts",
    "verify:data": "node --import tsx scripts/verify-scripture-packages.ts",
    "smoke:ai": "node --import tsx scripts/smoke-ai.ts",
    "seed:notes": "node --import tsx scripts/seed-test-notes.ts",
    "smoke:embed": "node --import tsx scripts/smoke-embed.ts",
    "smoke:extract": "node --import tsx scripts/smoke-extract.ts",
    "calibrate:margin": "node --import tsx scripts/calibrate-margin.ts",
    "eval:margin": "node --import tsx scripts/eval-margin.ts",
    "eval:personas": "node --import tsx scripts/eval-personas.ts",
    "smoke:enrich": "node --import tsx scripts/smoke-enrich.ts",
    "import:macula-greek": "node --import tsx scripts/import-macula-greek.ts",
    "import:oshb": "node --import tsx scripts/import-oshb.ts",
    "import:tipnr": "node --import tsx scripts/import-tipnr.ts",
    "import:macula-syntax": "node --import tsx scripts/import-macula-syntax.ts",
    "import:macula-hebrew-syntax": "node --import tsx scripts/import-macula-hebrew-syntax.ts",
    "import:esword-bible": "node --import tsx scripts/import-esword-bible.ts",
    "import:esword-dict": "node --import tsx scripts/import-esword-dict.ts",
    "import:bsb": "node --import tsx scripts/import-bsb-usfm.ts",
    "import:bsb-tables": "node --import tsx scripts/import-bsb-tables.ts",
    "build:reverse-index": "node --import tsx scripts/build-reverse-index.ts",
    "build:hebrew-orbit": "node --import tsx scripts/build-hebrew-orbit-index.ts",
    "import:openbible-crossrefs": "node --import tsx scripts/import-openbible-cross-references.ts",
    "import:openbible-places": "node --import tsx scripts/import-openbible-places.ts",
    "fetch:pleiades": "node scripts/fetch-pleiades-release.mjs",
    "import:pleiades": "node --import tsx scripts/import-pleiades.ts",
    "qa:sidebar": "node scripts/qa-sidebar-tour.mjs",
    "qa:topbar": "node scripts/qa-topbar-tour.mjs",
    "qa:canvas": "node scripts/qa-reading-canvas-tour.mjs",
    "qa:margin": "node scripts/qa-living-margin-tour.mjs",
    "qa:controls": "node scripts/qa-shared-controls-tour.mjs",
    "qa:study-overlays": "node scripts/qa-study-overlays-tour.mjs",
    "qa:route-lab-digests": "node scripts/qa-route-lab-digests.mjs",
    "qa:connections": "node scripts/qa-connection-alignment.mjs",
    "qa:connection-broker": "npm run build && npm run build:renderer && node scripts/qa-authored-connection-broker.mjs",
    "qa:connection-card": "node scripts/qa-connection-card.mjs",
    "qa:connection-card-mutations": "npm run build && npm run build:renderer && node scripts/qa-connection-card.mjs --mutations-only",
    "qa:connection-paint": "node scripts/qa-connection-paint.mjs",
    "qa:reading-interactions": "npm run build && npm run build:renderer && node scripts/qa-reading-interactions.mjs",
    "qa:pericope-integration": "npm run build && npm run build:renderer && node scripts/qa-pericope-integration.mjs",
    "qa:desktop-reading-control:run": "node scripts/qa-desktop-reading-control.mjs",
    "qa:desktop-reading-control": "npm run build && npm run build:renderer && npm run qa:desktop-reading-control:run",
    "qa:study-workspace-bar:run": "node scripts/qa-study-workspace-bar.mjs",
    "qa:study-workspace-bar": "npm run build && npm run build:renderer && npm run qa:study-workspace-bar:run",
    "qa:marking-palette": "node scripts/qa-marking-palette.mjs",
    "qa:marking-rail": "npm run build && npm run build:renderer && node scripts/qa-marking-rail.mjs",
    "qa:marking-rail-connection-retry": "npm run build && npm run build:renderer && node scripts/qa-marking-rail.mjs --connection-retry-only",
    "qa:marking-radial": "npm run build && npm run build:renderer && node scripts/qa-marking-radial.mjs",
    "qa:marking-dock": "npm run build && npm run build:renderer && node scripts/qa-marking-dock.mjs",
    "qa:setup": "node scripts/qa-setup-tour.mjs",
    "qa:notebook": "node scripts/qa-note-workspace-tour.mjs",
    "qa:command": "node scripts/qa-command-palette-tour.mjs",
    "qa:entities": "node scripts/qa-entity-research-tour.mjs",
    "qa:desktop": "node scripts/qa-desktop-regression.mjs"
  },
  "main": "dist/electron/main.cjs",
  "bin": {
    "library": "./dist/cli/index.js"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@xmldom/xmldom": "0.8.13",
    "@vitejs/plugin-react": "4.4.1",
    "better-sqlite3": "11.9.1",
    "electron": "35.0.1",
    "electron-store": "^11.0.2",
    "gray-matter": "4.0.3",
    "pdfjs-dist": "6.1.200",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "ulid": "2.3.0",
    "vite": "6.3.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.15.21",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.4",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
