        "source": "BibleProject",
        "audioUrl": "https://afp-597195-injected.calisto.simplecastaudio.com/695767b0-cd40-4e6c-ac8c-ac6bc0df77ee/episodes/414f5b9b-34dd-4aa8-8ef0-89952e924138/audio/128/default.mp3?awCollectionId=695767b0-cd40-4e6c-ac8c-ac6bc0df77ee&awEpisodeId=414f5b9b-34dd-4aa8-8ef0-89952e924138",
        "durationSec": 2909,
        "adInsertionDrift": false
      }
