  "tour": {
    "title": "Heaven: God’s Space, Our Hope, and the World Made New",
    "intro": "“Heaven” can mean several different things in Christian speech: God’s transcendent presence, the place believers are with Christ after death, or the final hope of resurrection and new creation. This tour moves carefully through those meanings, beginning with the Bible’s imagery and ending with the promise that God’s dwelling comes to humanity—not that humanity simply escapes the earth.",
    "steps": [
      {
        "recordId": "bibleproject:podcast:heaven-earth-part-1",
        "startSec": 575,
        "endSec": 713,
        "why": "Begin by clarifying the Bible’s basic imagery. The speakers explain that “God’s space or his presence is placed in the sky,” and connect heaven with God’s throne, rule, status, and transcendence rather than treating every “up” image as a literal map of the cosmos.",
        "episodeTitle": "What is the Old Testament referring to as \"Heaven\"?",
        "sourceId": "bibleproject",
        "source": "BibleProject",
        "audioUrl": "https://afp-597195-injected.calisto.simplecastaudio.com/695767b0-cd40-4e6c-ac8c-ac6bc0df77ee/episodes/7a2a37d8-d85b-4dc3-a51c-0c437bb00a53/audio/128/default.mp3?awCollectionId=695767b0-cd40-4e6c-ac8c-ac6bc0df77ee&awEpisodeId=7a2a37d8-d85b-4dc3-a51c-0c437bb00a53",
        "durationSec": 2453,
        "adInsertionDrift": false
